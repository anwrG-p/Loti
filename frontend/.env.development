# Enable live AI coach (Loti connected to FastAPI /v1/coach/chat)
VITE_LOTI_COACH=on

# Disable mock fixtures so frontend connects to the live backend task generator and difficulty engine
VITE_USE_MOCKS=false

# Backend API URL (proxied via Vite on port 5173 to port 8000)
VITE_API_BASE_URL=http://localhost:8000
